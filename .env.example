# Copy to .env. Do not commit .env.
# The app stays on DuckDB until STORAGE_BACKEND=postgres and alembic upgrade head.
STORAGE_BACKEND=duckdb

# Image superuser, used by Alembic. 127.0.0.1 is the laptop default.
# The lab host is still an open choice; set POSTGRES_HOST when that address is picked.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=cnc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cnc

# Application role. UPDATE and DELETE are revoked on events and operator_actions.
POSTGRES_APP_USER=cnc_app
POSTGRES_APP_PASSWORD=change-me

NATS_TOKEN=change-me
NATS_PORT=4222
# CNC_BUS is not copied from this file. Export CNC_BUS=nats to publish on JetStream.
# When the broker does not answer, commands stay on the in-process path.
CNC_BUS=off
CNC_NATS_URL=nats://127.0.0.1:4222

# cnc-redis requirepass. CNC_REDIS_URL must carry the same password.
REDIS_PASSWORD=change-me
CNC_REDIS_URL=redis://:change-me@localhost:6379/0
